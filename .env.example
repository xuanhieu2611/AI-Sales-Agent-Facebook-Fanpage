# ── OpenRouter (the AI brain) ────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# OpenRouter model slug. Default is the cheapest DeepSeek flash model.
# Switch anytime without code changes — examples:
#   deepseek/deepseek-v4-flash      -> cheapest (~$0.09/$0.18 per 1M)
#   deepseek/deepseek-v3.2          -> stronger, still cheap
#   anthropic/claude-haiku-4.5      -> previous Anthropic Haiku via OpenRouter
MODEL=deepseek/deepseek-v4-flash

# ── Facebook Messenger ───────────────────────────────────────────────
# From your Facebook App > Messenger > Settings
PAGE_ACCESS_TOKEN=EAAG...
# A random string YOU invent; you type the same value into the webhook setup
VERIFY_TOKEN=my-secret-verify-token-123

# ── Server ───────────────────────────────────────────────────────────
PORT=3000

# ── Database (Supabase Postgres) — state + scheduled follow-ups ───────
# If unset, the app uses an in-memory store (data resets on restart) — fine
# for the playground, NOT for production. Use the Supabase "Session pooler"
# connection string (see README "Phần 3"). Keep the ?sslmode=require suffix.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# ── Gift-video Drive access automation ───────────────────────────────
# Your Apps Script Web App URL. When a customer sends their email, the bot
# POSTs {email, psid, extension} here to grant/extend the 24h Drive access.
# If unset, the bot just logs what it would grant (safe for local testing).
GIFT_ACCESS_WEBHOOK_URL=

# ── Scheduler / timers (optional) ────────────────────────────────────
# How often the scheduler checks for due follow-ups (ms). Default 30000.
SCHEDULER_POLL_MS=30000
# Speed up ALL timers for testing (e.g. 0.002 turns 20h into ~2.4 min).
# Leave at 1 for production real-time.
TIMER_SCALE=1
